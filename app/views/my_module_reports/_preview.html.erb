
<div class="modal-header">
  <span class="file-name"><%= report.name %></span>
  <div class="sci-btn-group">
    <%= link_to download_my_module_my_module_report_path(my_module_id, report), class: 'btn btn-light file-download-link', data: { turbolinks: false } do %>
      <span class="sn-icon sn-icon-export"></span>
      <%= t('Download') %>
    <% end %>
    <button type="button" class="btn icon-btn btn-light" data-dismiss="modal"><span class="sn-icon sn-icon-close"></span></button>
  </div>
</div>
<div class="modal-body">
  <div class="file-preview-container">
    <%= render partial: 'shared/pdf_viewer', locals: { asset: report.report, report_document: true } %>
  </div>
</div>

<%= javascript_include_tag 'shared/file_preview', nonce: true %>
